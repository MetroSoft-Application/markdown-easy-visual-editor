{
  "name": "markdown-easy-visual-editor",
  "displayName": "Markdown Easy Visual Editor",
  "description": "A visual Markdown editor for VS Code with live preview, source editing, formatting tools, image support, and PDF export.",
  "version": "1.2.7",
  "publisher": "MetroSoft-Application",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetroSoft-Application/markdown-easy-visual-editor.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "custom editor",
    "preview",
    "mermaid",
    "pdf"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:markdownEasyVisualEditor.editor"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "PDF export is disabled until the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Local image assets and PDF export require a filesystem-backed workspace."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownEasyVisualEditor.editor",
        "displayName": "Markdown Easy Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "markdownEasyVisualEditor.openVisual",
        "title": "Markdown Easy Visual Editor: Open in visual editor"
      },
      {
        "command": "markdownEasyVisualEditor.openSource",
        "icon": "$(open-preview)",
        "title": "Markdown Easy Visual Editor: Open as text on the right"
      },
      {
        "command": "markdownEasyVisualEditor.insertImage",
        "title": "Markdown Easy Visual Editor: Insert image"
      },
      {
        "command": "markdownEasyVisualEditor.exportPdf",
        "title": "Markdown Easy Visual Editor: Export PDF"
      },
      {
        "command": "markdownEasyVisualEditor.exportHtml",
        "title": "Markdown Easy Visual Editor: Export HTML"
      },
      {
        "command": "markdownEasyVisualEditor.previewHtml",
        "title": "Markdown Easy Visual Editor: Preview HTML"
      },
      {
        "command": "markdownEasyVisualEditor.undo",
        "title": "Markdown Easy Visual Editor: Undo"
      },
      {
        "command": "markdownEasyVisualEditor.redo",
        "title": "Markdown Easy Visual Editor: Redo"
      },
      {
        "command": "markdownEasyVisualEditor.attachSelectionToCopilotChat",
        "title": "Attach Selection to GitHub Copilot Chat"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownEasyVisualEditor.openSource",
          "when": "activeCustomEditor == markdownEasyVisualEditor.editor",
          "group": "navigation@1"
        },
        {
          "command": "markdownEasyVisualEditor.exportPdf",
          "when": "activeCustomEditor == markdownEasyVisualEditor.editor",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownEasyVisualEditor.openVisual",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "markdownEasyVisualEditor.exportPdf",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@2"
        },
        {
          "command": "markdownEasyVisualEditor.exportHtml",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@3"
        },
        {
          "command": "markdownEasyVisualEditor.previewHtml",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "markdownEasyVisualEditor.openVisual",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownEasyVisualEditor.openVisual",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        }
      ],
      "webview/context": [
        {
          "command": "markdownEasyVisualEditor.attachSelectionToCopilotChat",
          "when": "webviewId == 'markdownEasyVisualEditor.editor' && webviewSection == 'sourceEditor' && mveHasSelection",
          "group": "3_chat"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownEasyVisualEditor.undo",
          "when": "false"
        },
        {
          "command": "markdownEasyVisualEditor.redo",
          "when": "false"
        },
        {
          "command": "markdownEasyVisualEditor.attachSelectionToCopilotChat",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+z",
        "command": "markdownEasyVisualEditor.undo",
        "when": "activeCustomEditor == markdownEasyVisualEditor.editor && !inputFocus"
      },
      {
        "key": "ctrl+y",
        "command": "markdownEasyVisualEditor.redo",
        "when": "activeCustomEditor == markdownEasyVisualEditor.editor && !inputFocus"
      },
      {
        "key": "ctrl+shift+z",
        "command": "markdownEasyVisualEditor.redo",
        "when": "activeCustomEditor == markdownEasyVisualEditor.editor && !inputFocus"
      },
      {
        "key": "cmd+z",
        "command": "markdownEasyVisualEditor.undo",
        "when": "activeCustomEditor == markdownEasyVisualEditor.editor && !inputFocus"
      },
      {
        "key": "cmd+y",
        "command": "markdownEasyVisualEditor.redo",
        "when": "activeCustomEditor == markdownEasyVisualEditor.editor && !inputFocus"
      },
      {
        "key": "cmd+shift+z",
        "command": "markdownEasyVisualEditor.redo",
        "when": "activeCustomEditor == markdownEasyVisualEditor.editor && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Markdown Easy Visual Editor",
      "properties": {
        "markdownEasyVisualEditor.language": {
          "type": "string",
          "enum": [
            "auto",
            "ja",
            "en",
            "zh-cn",
            "ko",
            "fr",
            "de",
            "es"
          ],
          "default": "auto",
          "description": "UI and message language. auto follows VS Code's display language.",
          "enumDescriptions": [
            "Follow VS Code display language",
            "Japanese",
            "English",
            "Chinese (Simplified)",
            "Korean",
            "French",
            "German",
            "Spanish"
          ]
        },
        "markdownEasyVisualEditor.editor.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ],
          "default": "dark",
          "description": "Color theme used inside Markdown Easy Visual Editor.",
          "enumDescriptions": [
            "Use the light editor theme",
            "Use the dark editor theme"
          ]
        },
        "markdownEasyVisualEditor.images.directory": {
          "type": "string",
          "default": "assets/${documentBasename}",
          "description": "Directory for images saved from Markdown files. You can use ${documentBasename}."
        },
        "markdownEasyVisualEditor.images.maxPasteSizeMb": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum size (MB) per pasted image."
        },
        "markdownEasyVisualEditor.remoteImages.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Allow remote images to be displayed."
        },
        "markdownEasyVisualEditor.mermaid.theme": {
          "type": "string",
          "enum": [
            "auto",
            "default",
            "dark",
            "neutral"
          ],
          "default": "auto",
          "description": "Theme for the Mermaid preview."
        },
        "markdownEasyVisualEditor.pdf.browserPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Edge or Chrome executable for PDF export. Leave empty to detect Edge, then Chrome."
        },
        "markdownEasyVisualEditor.editor.viewMode": {
          "type": "string",
          "enum": ["both", "preview", "text"],
          "enumDescriptions": ["Show source and preview", "Show preview only", "Show source only"],
          "default": "both",
          "scope": "application",
          "description": "Default editor panes shown when opening a Markdown file."
        },
        "markdownEasyVisualEditor.editor.outlineVisible": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the document outline panel by default."
        },
        "markdownEasyVisualEditor.editor.scrollSyncEnabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Synchronize scrolling between the source and preview panes."
        },
        "markdownEasyVisualEditor.preview.imageResizeControlsVisible": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show image resize controls in the preview."
        },
        "markdownEasyVisualEditor.fonts.editorFamily": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Font family used by the Markdown source editor. Leave empty to use the default."
        },
        "markdownEasyVisualEditor.fonts.previewFamily": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Font family used by the Markdown preview and PDF output. Leave empty to use the default."
        },
        "markdownEasyVisualEditor.pdf.format": {
          "type": "string",
          "enum": ["A0", "A1", "A2", "A3", "A4", "A5", "A6", "B4", "B5"],
          "default": "A4",
          "scope": "application",
          "description": "Paper size used for PDF export."
        },
        "markdownEasyVisualEditor.pdf.orientation": {
          "type": "string",
          "enum": ["portrait", "landscape"],
          "default": "portrait",
          "scope": "application",
          "description": "Page orientation used for PDF export."
        },
        "markdownEasyVisualEditor.pdf.margins.top": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 15,
          "scope": "application",
          "description": "Top PDF page margin in millimeters."
        },
        "markdownEasyVisualEditor.pdf.margins.right": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 15,
          "scope": "application",
          "description": "Right PDF page margin in millimeters."
        },
        "markdownEasyVisualEditor.pdf.margins.bottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 15,
          "scope": "application",
          "description": "Bottom PDF page margin in millimeters."
        },
        "markdownEasyVisualEditor.pdf.margins.left": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "default": 15,
          "scope": "application",
          "description": "Left PDF page margin in millimeters."
        },
        "markdownEasyVisualEditor.pdf.header": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Text printed in the PDF page header."
        },
        "markdownEasyVisualEditor.pdf.footer": {
          "type": "string",
          "default": "{page}/{pages}",
          "scope": "application",
          "description": "Text printed in the PDF page footer."
        },
        "markdownEasyVisualEditor.pdf.bodyFontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 48,
          "default": 11,
          "scope": "application",
          "description": "Body text size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.headingFontSizes.h1": {
          "type": "number",
          "minimum": 6,
          "maximum": 72,
          "default": 24,
          "scope": "application",
          "description": "H1 heading size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.headingFontSizes.h2": {
          "type": "number",
          "minimum": 6,
          "maximum": 72,
          "default": 20,
          "scope": "application",
          "description": "H2 heading size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.headingFontSizes.h3": {
          "type": "number",
          "minimum": 6,
          "maximum": 72,
          "default": 16,
          "scope": "application",
          "description": "H3 heading size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.headingFontSizes.h4": {
          "type": "number",
          "minimum": 6,
          "maximum": 72,
          "default": 14,
          "scope": "application",
          "description": "H4 heading size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.headingFontSizes.h5": {
          "type": "number",
          "minimum": 6,
          "maximum": 72,
          "default": 12,
          "scope": "application",
          "description": "H5 heading size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.headingFontSizes.h6": {
          "type": "number",
          "minimum": 6,
          "maximum": 72,
          "default": 11,
          "scope": "application",
          "description": "H6 heading size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.codeFontSize": {
          "type": "number",
          "minimum": 6,
          "maximum": 36,
          "default": 9,
          "scope": "application",
          "description": "Code block text size in PDF output."
        },
        "markdownEasyVisualEditor.pdf.lineHeight": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 3,
          "default": 1.6,
          "scope": "application",
          "description": "Line height used in PDF output."
        },
        "markdownEasyVisualEditor.pdf.paragraphSpacing": {
          "type": "number",
          "minimum": 0,
          "maximum": 48,
          "default": 6,
          "scope": "application",
          "description": "Space after paragraphs in PDF output, in points."
        },
        "markdownEasyVisualEditor.pdf.saveWithoutDialog": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Save PDF output beside the Markdown file without showing a save dialog."
        },
        "markdownEasyVisualEditor.html.embedImages": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Embed image files in exported HTML."
        },
        "markdownEasyVisualEditor.html.convertLinkedMarkdown": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Convert linked Markdown files to HTML during export."
        },
        "markdownEasyVisualEditor.html.saveWithoutDialog": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Save HTML output beside the Markdown file without showing a save dialog."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "check": "npm run check:documentation-comments && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "check:documentation-comments": "node scripts/check-documentation-comments.mjs",
    "test": "vitest run",
    "test:startup": "npm run build && node scripts/startup-regression.mjs",
    "benchmark:vscode-startup": "npm run build && node scripts/benchmark-vscode-startup.mjs",
    "test:lazy-runtime": "npm run build && node scripts/lazy-runtime-smoke.mjs",
    "test:extension": "npm run build && node scripts/test-extension-host.mjs",
    "test:packaged-extension": "npm run build && node scripts/test-packaged-extension.mjs",
    "test:ime": "node scripts/ime-caret-smoke.mjs",
    "test:outline-reorder": "npm run build && node scripts/outline-reorder-smoke.mjs",
    "test:smoke": "node scripts/smoke-fast.mjs",
    "test:smoke-build": "npm run build && npm run test:smoke",
    "test:sample-matrix": "npm run build && node scripts/sample-matrix.mjs",
    "test:pdf-preview": "npm run build && node scripts/pdf-preview-smoke.mjs",
    "test:watch": "vitest",
    "pdf:install-browser": "node scripts/install-pdf-browser.mjs",
    "package": "npm run check && npm test && npm run build && node scripts/startup-regression.mjs && node scripts/lazy-runtime-smoke.mjs && npm run test:smoke && npm run test:sample-matrix && vsce package --target win32-x64 --no-dependencies --allow-missing-repository --out markdown-easy-visual-editor-0.1.0-win32-x64.vsix"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "chromium-bidi": "0.5.22",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.26",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
